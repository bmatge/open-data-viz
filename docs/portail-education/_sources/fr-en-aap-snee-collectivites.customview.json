   "custom_view_html": "<ods-dataset-context context=\"frenaapsneecollectivites, frenaapsneeecoles\" frenaapsneecollectivites-dataset=\"fr-en-aap-snee-collectivites\" frenaapsneeecoles-dataset=\"fr-en-aap-snee-ecoles\" ng-init=\"colorsdep={};colorsreg={};\">\n\n    <ods-simple-tabs class=\"tab-pills\">\n        <ods-simple-tab keep-content=\"false\" label=\"Par régions\">\n            <ods-dataset-context context=\"regions\" ng-init=\"colorsreg={};\" regions-dataset=\"georef-france-region\" regions-domain=\"public.opendatasoft.com\">\n                <div ods-analysis=\"analysisreg\" ods-analysis-context=\"frenaapsneecollectivites\" ods-analysis-max=\"200\" ods-analysis-serie-montant=\"SUM(montant_de_la_subvention)\" ods-analysis-x=\"code_region\">\n                </div>\n                <div ng-repeat=\"resultreg in analysisreg.results track by $index\">\n                    <div ng-init=\"colorsreg[resultreg.x] = resultreg.montant &lt; 1000000 ? '#19630A' : resultreg.montant &lt; 5000000 ? '#F7B133' : resultreg.montant &lt; 10000000 ? '#F98C44' : '#E5352E';\">\n                    </div>\n                </div>\n\n                <div>\n                    <h2>Subventions aux collectivités par régions</h2>\n                    Zoomez pour avoir le détail par école\n                    <div class=\"map-container\">\n                        <ods-map location=\"5,46,6\" style=\"height: 500px\">\n\n                            <ods-map-layer color-by-field=\"reg_code\" color-categories=\"colorsreg\" color-categories-other=\"lightgrey\" context=\"regions\" display=\"categories\" shape-opacity=\"0.95\" title=\"Subventions par région\">\n                                <ul style=\"display: block; list-style-type: none; color: #2c3f56; padding:0; margin:0;\">\n                                    <li>\n                                        <strong style=\"font-size:17px;text-align: center;\">{{ record.fields.reg_name | limitTo:50 }}</strong>\n                                    </li>\n                                    <br/>\n\n                                    <ods-dataset-context context=\"regdetail\" regdetail-dataset=\"fr-en-aap-snee-collectivites\" regdetail-parameters=\"{'refine.code_region':''+record.fields.reg_code}\">\n                                        <div ods-adv-analysis=\"myData\" ods-adv-analysis-context=\"regdetail\" ods-adv-analysis-group-by=\"code_region as reg\" ods-adv-analysis-select=\"SUM(montant_de_la_subvention) as subventions, SUM(depenses_realisees_par_la_collectivite) as depenses_collectivite, \n                                                                      SUM(nombre_d_ecoles) as nb_ecoles, SUM(nombre_de_communes) as nb_communes\" style=\"\">\n\n                                            <li>\n                                                Dépenses réalisées par les collectivités du département : \n                                                {{ myData[0].depenses_collectivite | number : 0}} €\n                                            </li>\n                                            <li>\n                                                Subventions accordées : {{ myData[0].subventions | number : 0}} €\n                                            </li>\n                                            <li>\n                                                Nombre d'écoles concernées: {{ myData[0].nb_ecoles  }}\n                                            </li>\n                                            <li>\n                                                Nombre de communes concernées : {{ myData[0].nb_communes  }}\n                                            </li>\n                                        </div>              \n                                    </ods-dataset-context>\n                                </ul>\n                            </ods-map-layer>\n\n                            <ods-map-layer color=\"#2C3F56\" context=\"frenaapsneeecoles\" display=\"raw\" show-zoom-min=\"9\">\n                                <ul style=\"display: block; list-style-type: none; color: #2c3f56; padding:0; margin:0;\">\n                                    <li>\n                                        <strong style=\"font-size:17px;text-align: center;\">{{ record.fields.nom_de_l_ecole | limitTo:50 }}</strong>\n                                    </li>\n                                    <br/>\n                                    <li>\n                                        <strong>Nombre de classes : </strong>{{record.fields.nombre_de_classes_referentiel}}\n                                    </li>\n                                    <li>\n                                        <strong> Région : </strong>{{record.fields.region_academique_ou_com}}\n                                    </li>\n                                    <li>\n                                        <strong>Département : </strong>{{record.fields.departement_uai}}\n                                    </li>\n                                    <li>\n                                        <strong> Commune :</strong> {{record.fields.nom_de_la_commune_uai}}\n                                    </li>\n                                    <li>\n                                        <strong> Collectivité signataire de la convention: </strong>{{record.fields.raison_sociale_du_signataire_de_la_convention}}\n                                    </li>\n                                </ul>\n                            </ods-map-layer>\n\n                            <div class=\"odswidget odswidget-map-legend\">\n                                <div class=\"odswidget-map-legend__header\">\n                                    <div class=\"odswidget-map-legend__title\" title=\"Subventions accordées aux collectivités\">\n                                        Subventions accordées aux collectivités\n                                    </div>\n                                </div>\n\n    